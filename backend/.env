# ── Database ──────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:123456@localhost:5432/medifind_db
SYNC_DATABASE_URL=postgresql://medifind:123456@localhost:5432/medifind_db

# ── Security ──────────────────────────────────────────────────
SECRET_KEY=medifind-secret-key-abc123xyz456
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── Redis (WebSocket pub/sub) ─────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── File Storage ──────────────────────────────────────────────
# Set STORAGE_BACKEND=local for development, s3 for production
STORAGE_BACKEND=local
LOCAL_UPLOAD_DIR=./uploads

# AWS S3 (only needed if STORAGE_BACKEND=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=medifind-prescriptions
AWS_REGION=ap-northeast-1

# ── OCR ───────────────────────────────────────────────────────
# Set OCR_BACKEND=tesseract for free local OCR
# Set OCR_BACKEND=openai to use GPT-4 Vision (more accurate)
OCR_BACKEND=tesseract
OPENAI_API_KEY=

# ── App ───────────────────────────────────────────────────────
APP_NAME=MediFind
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
REQUEST_EXPIRE_MINUTES=30
SEARCH_RADIUS_KM=5.0
